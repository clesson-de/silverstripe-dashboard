{
  "private": true,
  "scripts": {
    "build:js": "rollup -c",
    "build:css": "sass client/admin/src/scss/dashboard.scss client/admin/dist/bundle.css --no-source-map",
    "build": "npm run build:js && npm run build:css",
    "watch:js": "rollup -c --watch",
    "watch:css": "sass --watch client/admin/src/scss/dashboard.scss client/admin/dist/bundle.css --no-source-map",
    "watch": "npm run watch:js & npm run watch:css"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "rollup": "^4.0.0",
    "sass": "^1.0.0"
  }
}

