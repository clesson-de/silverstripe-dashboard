{
  "name": "clesson-de/silverstripe-dashboard",
  "description": "Configurable dashboard fields for Silverstripe CMS 6",
  "type": "silverstripe-vendormodule",
  "license": "BSD-3-Clause",
  "require": {
    "php": "^8.3",
    "silverstripe/framework": "^6",
    "silverstripe/admin": "^3"
  },
  "autoload": {
    "psr-4": {
      "Clesson\\Silverstripe\\Dashboard\\": "src/"
    }
  },
  "extra": {
    "expose": ["client/admin/dist"]
  },
  "require-dev": {
    "clesson-de/silverstripe-codeguard": "*"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  }
}
