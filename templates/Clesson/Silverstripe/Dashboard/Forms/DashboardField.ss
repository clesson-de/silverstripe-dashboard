<div class="dashboard-field"
     id="{$ID}_dashboard"
     data-dashboard-key="{$DashboardKey}"
     data-config-url="{$ConfigURL}"
     data-panels-url="{$PanelsURL}"
     data-save-url="{$SaveURL}"
     data-label-manage-panels="{$LabelManagePanels}"
     data-label-close="{$LabelClose}"
     data-label-single="{$LabelSingle}"
     data-label-double="{$LabelDouble}"
     data-label-loading="{$LabelLoading}"
     data-label-settings="{$LabelSettings}"
     data-label-save="{$LabelSave}"
     style="width: 100%; min-height: 600px;">
    <div class="dashboard-field__loading">{$LabelLoading}</div>
</div>
